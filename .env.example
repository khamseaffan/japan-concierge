# Copy to .env for local development. Never commit .env.

# Postgres
DATABASE_URL=postgresql://japan_concierge:dev_password@localhost:5432/japan_concierge?sslmode=disable

# MinIO (S3-compatible local storage for documents)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=japan-concierge-docs
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# HTTP
HTTP_ADDR=:8080

# Single-user mode: when true, all requests run as user_id=1, no auth.
# Flip to false once Clerk integration ships.
SINGLE_USER_MODE=true

# LLM / OCR (unused in v1 step 1-2, populated when document pipeline lands)
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
